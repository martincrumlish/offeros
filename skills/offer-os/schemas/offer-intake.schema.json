{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeros.local/schemas/offer-intake.schema.json",
  "title": "OfferOS Offer Intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "offer", "audience", "commercial", "pageKit"],
  "properties": {
    "schema": { "const": "offeros/offer-intake/v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "briefPath": { "type": "string" },
        "interviewDate": { "type": "string" },
        "assumptionMode": { "enum": ["ask", "assume-and-record"] }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "promise", "mechanism", "deliverables"],
      "properties": {
        "name": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "type": "string", "minLength": 2 },
        "promise": { "type": "string", "minLength": 12 },
        "mechanism": { "type": "string", "minLength": 4 },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 3 }
        },
        "bonuses": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buyer", "problem", "desiredOutcome", "awareness"],
      "properties": {
        "buyer": { "type": "string", "minLength": 4 },
        "problem": { "type": "string", "minLength": 8 },
        "desiredOutcome": { "type": "string", "minLength": 8 },
        "awareness": {
          "enum": ["problem-aware", "solution-aware", "product-aware", "mixed", "unknown"]
        },
        "objections": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 4 }
        },
        "failedAlternatives": {
          "type": "array",
          "items": { "type": "string", "minLength": 4 }
        }
      }
    },
    "commercial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["price", "currency", "guarantee", "proofLevel"],
      "properties": {
        "price": { "type": "string", "minLength": 1 },
        "currency": { "type": "string", "minLength": 1 },
        "normalValue": { "type": "string" },
        "guarantee": { "type": "string", "minLength": 4 },
        "proofLevel": { "enum": ["none", "substitute", "examples", "case-studies", "hard-proof"] },
        "proofAssets": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "voice": { "type": "string" },
        "existingAssets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "pageKit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pageType", "pageKitArchetype", "themePreset", "checkoutTarget", "orderFormPolicy"],
      "properties": {
        "pageType": { "const": "direct-response-long-form-vsl" },
        "pageKitArchetype": {
          "enum": ["classic-vsl-longform", "modern-vsl-software", "one-page-tripwire", "challenge-workshop", "toolkit-workbook"],
          "default": "classic-vsl-longform"
        },
        "themePreset": {
          "enum": ["light-saas-direct-response", "classic-direct-response", "bold-webinar", "premium-editorial", "fitness-performance", "creator-workshop"],
          "default": "classic-direct-response"
        },
        "checkoutTarget": { "type": "string", "default": "#checkout" },
        "orderFormPolicy": { "const": "no-embedded-order-form" },
        "themePath": { "type": "string", "default": "theme.json" },
        "blueprintPath": { "type": "string", "default": "sales-page-blueprint.json" }
      }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 4 }
    }
  }
}
