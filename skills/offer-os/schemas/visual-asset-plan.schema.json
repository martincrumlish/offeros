{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://offeros.local/schemas/visual-asset-plan.schema.json",
  "title": "OfferOS Visual Asset Plan v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "visualPlanStage",
    "copyBlueprintUsed",
    "salesPageImageSystem",
    "primaryConversionFinalPixelsPolicy",
    "aspectRatioPolicy",
    "logoReference",
    "logoUsagePolicy",
    "alternateLogosCreated",
    "salesPageVisuals",
    "pdfProductVisuals",
    "vslDeckVisuals",
    "adVisuals"
  ],
  "properties": {
    "schema": { "const": "offeros/visual-asset-plan/v2" },
    "visualPlanStage": { "const": "post-content-blueprint" },
    "copyBlueprintUsed": { "const": true },
    "salesPageImageSystem": { "const": "mixed-direct-response-v1" },
    "primaryConversionFinalPixelsPolicy": { "const": "imagegen-final-v1" },
    "aspectRatioPolicy": { "const": "slot-aware-v1" },
    "logoReference": { "const": "assets/logo.png" },
    "logoUsagePolicy": { "const": "use-locked-logo-reference" },
    "alternateLogosCreated": { "const": false },
    "mockupHeavyUserRequested": { "type": "boolean" },
    "salesPageVisuals": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/visualRow" }
    },
    "pdfProductVisuals": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/visualRow" }
    },
    "vslDeckVisuals": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/visualRow" }
    },
    "adVisuals": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/visualRow" }
    }
  },
  "$defs": {
    "visualRow": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "artifactTarget",
        "filePath",
        "visualKind",
        "copyAnchor",
        "conversionJob",
        "aspectRatio",
        "aspectRatioReason",
        "displayIntent",
        "maxDisplayHeight",
        "textRule",
        "source/provenance",
        "finalPixelsGeneratedBy",
        "localPostprocess",
        "localCreativeOverlay"
      ],
      "properties": {
        "artifactTarget": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "visualKind": {
          "enum": [
            "hero-vsl-frame",
            "product-mockup",
            "dashboard-mockup",
            "offer-stack-bundle",
            "mechanism-diagram",
            "comparison-visual",
            "proof-demo-visual",
            "buyer-situation-photo",
            "structured-panel",
            "worksheet-preview",
            "matrix-visual",
            "checklist-visual",
            "slide-pattern-interrupt",
            "ad-creative",
            "brand-frame"
          ]
        },
        "copyAnchor": { "type": "string", "minLength": 1 },
        "conversionJob": { "type": "string", "minLength": 8 },
        "aspectRatio": { "type": "string", "minLength": 3 },
        "aspectRatioReason": { "type": "string", "minLength": 8 },
        "displayIntent": { "type": "string", "minLength": 3 },
        "maxDisplayHeight": { "type": "string", "minLength": 3 },
        "textRule": { "type": "string", "minLength": 3 },
        "source/provenance": {
          "enum": ["imagegen", "imagegen-final", "imagegen-composite", "provided", "licensed", "screenshot", "html-css", "manual", "generated-by-code"]
        },
        "finalPixelsGeneratedBy": { "type": "string", "minLength": 1 },
        "localPostprocess": {
          "type": "array",
          "items": {
            "enum": ["crop", "resize", "compression", "format-conversion", "non-creative-qa-fix"]
          }
        },
        "localCreativeOverlay": { "type": "boolean" },
        "imagegenNativeComposite": { "type": "boolean" }
      }
    }
  }
}
